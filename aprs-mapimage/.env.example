# Copy to .env and edit.  One VAR=value per line, no quotes.

# Centre of your area (latitude,longitude): the default map centre and listening area.
APRS_HOME=40.00,-75.00
# How far around APRS_HOME to listen (miles).  Saved presets add their own areas.
LISTEN_MILES=50

# Your callsign, used only to log in to APRS-IS.  Receive only: nothing is ever transmitted,
# so no passcode is needed.  Give it an SSID that nothing else of yours uses: APRS-IS servers
# hold back packets from the callsign-SSID a client is logged in as, so if this matched the
# callsign your object scripts send from, your own objects would never show up here.
CALLSIGN=N0CALL-13

# Sign-in for the builder page and the API (your browser asks once).  Leave ADMIN_PASSWORD
# empty for no sign-in.  Avoid $ in these values (docker compose would try to expand it).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional: make the picture addresses need ?key=<this> as well.  E-paper displays usually
# cannot sign in, so they use the key; the builder adds it to every address it shows you.
# Leave empty to keep pictures open.
IMAGE_KEY=

# Old positions.  The server keeps the last position of every station and object it hears for
# HISTORY_DAYS, so a followed station that has gone quiet stays on the map, marked as old.
# HISTORY_DAYS=30
# Optional: an aprs.fi API key (free: aprs.fi account > Account settings) to look up stations
# and objects this server never heard.  Asked only when a picture or the builder needs one, and
# cached for APRSFI_CACHE_MINUTES.  PUBLIC_URL is sent to aprs.fi as this app's home page.
APRSFI_KEY=
PUBLIC_URL=
# APRSFI_CACHE_MINUTES=30

# Time zone for the clock on the pictures.
TZ=America/New_York

# Optional: an e-mail or website sent to the National Weather Service (county lines) and
# OpenStreetMap (roads, rivers, towns) with each download, as they ask.
NWS_CONTACT=

# Base map: downloaded ahead of time, in tiles, for this many miles around APRS_HOME
# (default: LISTEN_MILES, at most 60), plus every preset and followed station.  The first
# start takes a few minutes; after that it comes from the /data volume.
# PREFETCH_MILES=50

# Optional tuning
# FORGET_MINUTES=90      # drop a station or object not heard for this long
# TRAIL_MINUTES=180      # how much of each path to keep and draw
# APRS_BACKFILL=0        # do not fetch the last ~30 minutes of APRS-IS history at start
# EINK_OSM=0             # no OpenStreetMap downloads: roads, rivers and towns come from the built-in world map
# EINK_COUNTIES=0        # no county lines on the base map
# WORLD_MAP=0            # no Natural Earth world map (borders, highways, rivers, cities worldwide)
# EINK_SYMBOLS=0         # do not download the APRS symbol pictures
# LOG_REQUESTS=1         # log every picture request
